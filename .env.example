# Reference values for the new API. Go does not automatically load this file.
# Export variables in your shell, or configure them in your chosen process runner.
HTTP_ADDR=:8080

# Optional: omit to run the scoring API without PostgreSQL.
# Local development URL for docker compose up -d db.
# Go does not load this file; export DATABASE_URL explicitly to enable the pool.
DATABASE_URL=postgres://postgres:password@localhost:5432/postgres?sslmode=disable
